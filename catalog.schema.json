{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Agent Skills catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "project",
    "reviewed_at",
    "project_license",
    "categories",
    "recommendations",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "project": {
      "const": "awesome-universal-agent-skills"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "project_license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommended_expression",
        "scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed_not_granted",
            "adopted"
          ]
        },
        "recommended_expression": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "required": [
        "office",
        "data",
        "development",
        "automation",
        "agent"
      ]
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featured",
        "conditional",
        "reference"
      ],
      "properties": {
        "featured": {
          "type": "string",
          "minLength": 1
        },
        "conditional": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "display_name",
          "category",
          "recommendation",
          "upstream",
          "license",
          "purpose",
          "recommendation_reason",
          "dependencies",
          "limitations",
          "adoption_gate",
          "example_request",
          "validation",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "recommendation_reason": {
            "type": "string",
            "minLength": 1
          },
          "adoption_gate": {
            "type": "string",
            "minLength": 1
          },
          "example_request": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "office",
              "data",
              "development",
              "automation",
              "agent",
              "research",
              "security",
              "design"
            ]
          },
          "recommendation": {
            "enum": [
              "featured",
              "conditional",
              "reference"
            ]
          },
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "directory",
              "commit",
              "directory_url",
              "skill_url",
              "maintainer",
              "maintainer_kind",
              "authorship_note",
              "version_label"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "directory": {
                "type": "string",
                "minLength": 1
              },
              "maintainer": {
                "type": "string",
                "minLength": 1
              },
              "authorship_note": {
                "type": "string",
                "minLength": 1
              },
              "version_label": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "directory_url": {
                "type": "string",
                "format": "uri"
              },
              "skill_url": {
                "type": "string",
                "format": "uri"
              },
              "maintainer_kind": {
                "enum": [
                  "organization",
                  "project",
                  "community"
                ]
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_expression",
              "skill_license_url",
              "scope_note",
              "dependencies_review"
            ],
            "properties": {
              "skill_expression": {
                "enum": [
                  "MIT",
                  "Apache-2.0",
                  "CC-BY-SA-4.0",
                  "Proprietary"
                ]
              },
              "skill_license_url": {
                "type": "string",
                "format": "uri"
              },
              "scope_note": {
                "type": "string",
                "minLength": 1
              },
              "dependencies_review": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "network_requirement",
              "notes"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "network_requirement": {
                "enum": [
                  "required",
                  "not_required_for_local_core",
                  "depends_on_workflow"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "static_review",
              "function",
              "evidence_summary",
              "cross_client_runtime",
              "upstream_full_test_suite"
            ],
            "properties": {
              "format": {
                "const": "basic_frontmatter_checked"
              },
              "static_review": {
                "const": "reviewed_scope_only"
              },
              "function": {
                "enum": [
                  "local_core_sample_passed",
                  "not_tested"
                ]
              },
              "evidence_summary": {
                "type": "string",
                "minLength": 1
              },
              "cross_client_runtime": {
                "const": "not_verified"
              },
              "upstream_full_test_suite": {
                "const": "not_run"
              }
            }
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "runtime_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version",
                "url",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "navigation_scope": {
            "type": "string",
            "enum": [
              "restricted_reference"
            ],
            "description": "Optional restrictive navigation scope. These entries provide original commentary and upstream links only; no source extraction, external installation/execution, or redistribution authorization is granted."
          }
        }
      }
    }
  }
}
