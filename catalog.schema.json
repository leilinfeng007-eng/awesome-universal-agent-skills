{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leilinfeng007-eng/awesome-universal-agent-skills/blob/main/catalog.schema.json",
  "title": "Task-first Skill directory",
  "type": "object",
  "required": ["schema_version", "project", "categories", "levels", "clients", "skills", "archived"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "project": {"const": "awesome-universal-agent-skills"},
    "updated_at": {"type": "string", "format": "date"},
    "categories": {"type": "object", "additionalProperties": {"type": "string"}},
    "levels": {"type": "object", "required": ["everyday", "specialist"]},
    "clients": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "label", "mode", "directory", "invoke", "source", "note"],
        "properties": {
          "id": {"type": "string"}, "label": {"type": "string"},
          "mode": {"enum": ["folder", "import"]},
          "directory": {"type": "string"}, "invoke": {"type": "string"},
          "source": {"type": "string", "format": "uri"}, "note": {"type": "string"}
        }
      }
    },
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "slug", "title", "summary", "category", "level", "audience", "prerequisites", "start_note", "comparison", "prompt", "upstream", "license", "validation", "clients", "detail_url", "fetch_mode", "ready_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+--[a-z0-9-]+$"},
          "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "level": {"enum": ["everyday", "specialist"]},
          "audience": {"type": "string"},
          "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "start_note": {"type": "string"}, "comparison": {"type": "string"}, "prompt": {"type": "string"},
          "upstream": {
            "type": "object", "required": ["repository", "directory", "commit", "directory_url", "skill_url", "maintainer"],
            "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "directory_url": {"type": "string", "format": "uri"}, "skill_url": {"type": "string", "format": "uri"}}
          },
          "license": {"type": "object", "required": ["skill_expression", "skill_license_url"]},
          "validation": {"type": "object", "required": ["function", "evidence_summary", "cross_client_runtime"], "properties": {"cross_client_runtime": {"const": "not_verified"}}},
          "clients": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "detail_url": {"type": "string", "pattern": "^skills/[a-z0-9-]+\\.md$"},
          "fetch_mode": {"enum": ["guided", "single_file", "prepare_first"]},
          "ready_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "archived": {
      "type": "array", "items": {"type": "object", "required": ["id", "reason", "details"], "properties": {"id": {"type": "string"}, "reason": {"type": "string"}, "details": {"type": "string"}}}
    }
  }
}
